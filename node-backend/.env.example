# Ledgerly AI: provider identities are private infrastructure.
# Only Codex CLI and Claude Code CLI are accepted.
LEDGERLY_AI_ENABLED=true
LEDGERLY_AI_DEFAULT_PROVIDER=codex
LEDGERLY_AI_FALLBACK_PROVIDER=claude-code
LEDGERLY_AI_EXECUTION_MODE=docker
LEDGERLY_AI_DOCKER_NETWORK=bridge
LEDGERLY_AI_CODEX_BIN=codex
LEDGERLY_AI_CLAUDE_BIN=claude
LEDGERLY_AI_DOCKER_BIN=docker
LEDGERLY_AI_CODEX_IMAGE=ledgerly-ai-codex:local
LEDGERLY_AI_CLAUDE_IMAGE=ledgerly-ai-claude-code:local
LEDGERLY_AI_SESSION_ROOT=/var/lib/ledgerly-ai/sessions
LEDGERLY_AI_WORK_ROOT=/var/lib/ledgerly-ai/workspaces
LEDGERLY_AI_JOB_TIMEOUT_MS=300000
LEDGERLY_AI_HEALTH_TIMEOUT_MS=10000
LEDGERLY_AI_MAX_CONCURRENCY=4
LEDGERLY_AI_MAX_QUEUE=100
LEDGERLY_AI_USER_REQUESTS_PER_MINUTE=20
LEDGERLY_AI_ORG_REQUESTS_PER_MINUTE=200
LEDGERLY_AI_AGENT_REQUESTS_PER_MINUTE=60
LEDGERLY_AI_CHAT_HISTORY_MESSAGES=30
LEDGERLY_AI_SHORT_TERM_MEMORY_DAYS=7
LEDGERLY_AI_MEMORY_RETRIEVAL_LIMIT=12
LEDGERLY_AI_MEMORY_CONTEXT_CHARS=12000
LEDGERLY_AI_MAX_TOOL_STEPS=6
LEDGERLY_AI_TOOL_TIMEOUT_MS=120000
LEDGERLY_AI_TOOL_MAX_RESULT_BYTES=524288
LEDGERLY_AI_REPO_ROOT=/opt/ledgerly/source
# Host path containing this checkout; used only for fixed engineering tools.
LEDGERLY_SOURCE_ROOT=/opt/ledgerly/source
LEDGERLY_AI_MAX_OUTPUT_BYTES=4194304
LEDGERLY_AI_RETRY_ATTEMPTS=1
LEDGERLY_AI_RETRY_BACKOFF_MS=1000
# 0 means no soft usage cap; set these if subscription limits need protection.
LEDGERLY_AI_CODEX_SOFT_JOBS_PER_HOUR=0
LEDGERLY_AI_CLAUDE_SOFT_JOBS_PER_HOUR=0
LEDGERLY_AI_LOG_PROMPTS=false
LEDGERLY_AI_STARTUP_HEALTHCHECK=true
# When true, Tuma (the release employee) reviews and deploys non-critical
# incident fixes with no human approval click. Critical (two-owner) changes
# always still require real human reviewers regardless of this flag.
LEDGERLY_AI_AUTONOMOUS_RELEASE_ENABLED=false
# Host path (as seen from inside the api/queue containers, via the
# LEDGERLY_SOURCE_ROOT mount) to the docker-compose project Tuma deploys.
LEDGERLY_AI_DEPLOY_COMPOSE_DIR=/opt/ledgerly/source/node-backend
LEDGERLY_AI_DEPLOY_SERVICES=api,queue
LEDGERLY_AI_DEPLOY_TIMEOUT_MS=600000
